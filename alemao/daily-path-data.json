{"courses": [{"id": "A1-01", "level": "A1", "title": "Primeiro dia no curso", "goal": "Apresentar-se com sein.", "rule": "Sein muda conforme a pessoa: ich bin, du bist, er/sie/es ist, wir sind, ihr seid, sie/Sie sind. A tradução ser ou estar depende do contexto.", "task": "Apresente você e Sofia em duas frases com sein.", "story": [{"de": "Hallo, ich bin Jefferson.", "pt": "Olá, eu sou Jefferson.", "audio": "audio/16a168b80bceb7412bd7.mp3"}, {"de": "Ich bin Sofia. Bist du aus Brasilien?", "pt": "Eu sou Sofia. Você é do Brasil?", "audio": "audio/61beeccea17ff9b97d23.mp3"}, {"de": "Ja, ich bin aus Brasilien.", "pt": "Sim, eu sou do Brasil.", "audio": "audio/f0a72a9b1685e0bcdf9b.mp3"}, {"de": "Wir sind im Deutschkurs.", "pt": "Nós estamos no curso de alemão.", "audio": "audio/d747178124f3b02d5921.mp3"}]}, {"id": "A1-02", "level": "A1", "title": "Nossa rotina de estudo", "goal": "Conjugar verbos regulares no presente.", "rule": "No presente regular, use o radical e as terminações: ich -e, du -st, er/sie/es -t, wir -en, ihr -t, sie/Sie -en. Aprenda os verbos irregulares separadamente.", "task": "Descreva duas atividades da sua rotina com lernen e machen.", "story": [{"de": "Ich lerne jeden Tag Deutsch.", "pt": "Eu estudo alemão todos os dias.", "audio": "audio/0363d63fa53102447f31.mp3"}, {"de": "Lernst du auch am Abend?", "pt": "Você também estuda à noite?", "audio": "audio/e4ae204e5c723beccc32.mp3"}, {"de": "Ja, wir lernen zusammen.", "pt": "Sim, nós estudamos juntos.", "audio": "audio/5d9b992693c6b2ef994f.mp3"}, {"de": "Sofia macht die Übungen.", "pt": "Sofia faz os exercícios.", "audio": "audio/a9742f65b6c9afa1319a.mp3"}]}, {"id": "A1-03", "level": "A1", "title": "Conhecer alguém", "goal": "Formar perguntas com e sem palavra interrogativa.", "rule": "Em perguntas com wie, wo ou woher, a palavra interrogativa vem antes do verbo conjugado. Em perguntas de sim ou não, o verbo ocupa a primeira posição: Wohnst du hier?", "task": "Escreva uma pergunta de nome e outra de lugar de moradia.", "story": [{"de": "Wie heißt du?", "pt": "Como você se chama?", "audio": "audio/2753e4860651be83bea8.mp3"}, {"de": "Ich heiße Sofia.", "pt": "Eu me chamo Sofia.", "audio": "audio/d85180ff7baaba8e195e.mp3"}, {"de": "Wo wohnst du?", "pt": "Onde você mora?", "audio": "audio/f13f25a375359b4c00b1.mp3"}, {"de": "Ich wohne in São Paulo.", "pt": "Eu moro em São Paulo.", "audio": "audio/53a56517eba1675119d8.mp3"}]}, {"id": "A1-04", "level": "A1", "title": "Objetos na sala", "goal": "Reconhecer artigos e gênero dos substantivos.", "rule": "No nominativo, o artigo definido é der no masculino, die no feminino e das no neutro. No plural, use die. Aprenda cada substantivo junto com o artigo e o plural.", "task": "Apresente dois objetos com artigo definido e ist.", "story": [{"de": "Das ist der Tisch.", "pt": "Esta é a mesa.", "audio": "audio/16625baedaaf7efd1306.mp3"}, {"de": "Die Tasche ist blau.", "pt": "A bolsa é azul.", "audio": "audio/9398c586b756ca3dd554.mp3"}, {"de": "Das Buch ist interessant.", "pt": "O livro é interessante.", "audio": "audio/738e14730e2775ff6622.mp3"}, {"de": "Die Bücher sind hier.", "pt": "Os livros estão aqui.", "audio": "audio/0e8e34de5722c2231b60.mp3"}]}, {"id": "A1-05", "level": "A1", "title": "O que temos e o que não temos", "goal": "Negar com nicht e kein.", "rule": "Kein nega substantivos com artigo indefinido ou sem artigo e recebe terminações. Nicht nega, por exemplo, um adjetivo: nicht warm. No acusativo masculino, ein vira einen e kein vira keinen.", "task": "Negue uma informação sobre um objeto e outra sobre uma qualidade.", "story": [{"de": "Hast du einen Kaffee?", "pt": "Você tem um café?", "audio": "audio/ab79bf8fb397f1b39bc1.mp3"}, {"de": "Nein, ich habe keinen Kaffee.", "pt": "Não, eu não tenho café.", "audio": "audio/bdbbbd8b9be8e071833a.mp3"}, {"de": "Ist das Wasser warm?", "pt": "A água está morna?", "audio": "audio/b997f7d0aac96a767356.mp3"}, {"de": "Nein, das Wasser ist nicht warm.", "pt": "Não, a água não está morna.", "audio": "audio/f7295038fcd3d67591b2.mp3"}]}, {"id": "A1-06", "level": "A1", "title": "Nossa família", "goal": "Usar possessivos no nominativo.", "rule": "No nominativo, mein e dein acompanham masculino e neutro; meine e deine acompanham feminino e plural. Unser recebe terminações de acordo com o substantivo: unser Bruder, unsere Schwester, unsere Eltern.", "task": "Apresente duas pessoas da sua família usando possessivos.", "story": [{"de": "Das ist mein Bruder.", "pt": "Este é meu irmão.", "audio": "audio/c8fb94901c4a8bb6f6c4.mp3"}, {"de": "Ist das deine Schwester?", "pt": "Esta é sua irmã?", "audio": "audio/409040f854e74c29b240.mp3"}, {"de": "Ja, meine Schwester heißt Ana.", "pt": "Sim, minha irmã se chama Ana.", "audio": "audio/33b15c7ba4a30e0dd95a.mp3"}, {"de": "Unsere Eltern wohnen in Brasilien.", "pt": "Nossos pais moram no Brasil.", "audio": "audio/6311b54a59f55bba6772.mp3"}]}, {"id": "A1-07", "level": "A1", "title": "Compras no mercado", "goal": "Reconhecer o acusativo do objeto direto.", "rule": "No acusativo, o masculino muda: der vira den e ein vira einen. Feminino e neutro mantêm die/eine e das/ein. Kaufen, brauchen e nehmen podem ter objeto direto no acusativo.", "task": "Escreva dois itens que você compra, usando um substantivo masculino.", "story": [{"de": "Ich kaufe einen Apfel.", "pt": "Eu compro uma maçã.", "audio": "audio/c9ac8b8abe7705c4d7bf.mp3"}, {"de": "Sofia kauft eine Banane.", "pt": "Sofia compra uma banana.", "audio": "audio/96a7776a8685a6d24d0e.mp3"}, {"de": "Wir brauchen das Brot.", "pt": "Nós precisamos do pão.", "audio": "audio/307923b5a06e49146b84.mp3"}, {"de": "Ich nehme den Käse.", "pt": "Eu vou levar o queijo.", "audio": "audio/48f7de31716ee4647037.mp3"}]}, {"id": "A1-08", "level": "A1", "title": "Hora do almoço", "goal": "Usar haben e mudanças vocálicas no presente.", "rule": "Haben é irregular: ich habe, du hast, er/sie/es hat, wir haben. Em essen, du e er/sie/es mudam para isst. Em nehmen, use du nimmst e er/sie/es nimmt.", "task": "Diga que está com fome e escreva o que gosta de comer.", "story": [{"de": "Ich habe Hunger.", "pt": "Eu estou com fome.", "audio": "audio/d86fda50e8ecd6e13855.mp3"}, {"de": "Was isst du gern?", "pt": "O que você gosta de comer?", "audio": "audio/338c77f416d562e86caf.mp3"}, {"de": "Ich esse gern Reis.", "pt": "Eu gosto de comer arroz.", "audio": "audio/af7a3e88b61e10662f12.mp3"}, {"de": "Sofia nimmt eine Suppe.", "pt": "Sofia pede uma sopa.", "audio": "audio/3966340c84521036e95f.mp3"}]}, {"id": "A1-09", "level": "A1", "title": "Planejar o fim de semana", "goal": "Usar verbos modais com infinitivo.", "rule": "O modal é conjugado e o outro verbo fica no infinitivo no final: Ich kann kommen. Aprenda as formas de können e müssen; möchte expressa um desejo de forma cortês.", "task": "Escreva algo que consegue fazer e algo que precisa fazer.", "story": [{"de": "Ich kann am Samstag kommen.", "pt": "Eu posso vir no sábado.", "audio": "audio/a400363f0691e1502e8f.mp3"}, {"de": "Musst du am Sonntag arbeiten?", "pt": "Você precisa trabalhar no domingo?", "audio": "audio/be1868e655d56f11aab2.mp3"}, {"de": "Nein, ich möchte Deutsch lernen.", "pt": "Não, eu gostaria de estudar alemão.", "audio": "audio/70b47848374f101e63da.mp3"}, {"de": "Wir können zusammen üben.", "pt": "Nós podemos praticar juntos.", "audio": "audio/4747bd870736e1fefb38.mp3"}]}, {"id": "A1-10", "level": "A1", "title": "Um dia organizado", "goal": "Separar prefixos de verbos separáveis.", "rule": "Na oração principal, o verbo separável deixa o prefixo no final: aufstehen vira Ich stehe auf. Com modal, o infinitivo fica junto: Ich muss aufstehen.", "task": "Conte a hora em que se levanta e quando telefona para alguém.", "story": [{"de": "Ich stehe um sieben Uhr auf.", "pt": "Eu me levanto às sete horas.", "audio": "audio/fb8b8f1c94707687e6ff.mp3"}, {"de": "Sofia kauft am Nachmittag ein.", "pt": "Sofia faz compras à tarde.", "audio": "audio/5357c26b682900e3ea2e.mp3"}, {"de": "Wann rufst du mich an?", "pt": "Quando você me liga?", "audio": "audio/14cb3fe3f53928740fd9.mp3"}, {"de": "Ich rufe dich am Abend an.", "pt": "Eu ligo para você à noite.", "audio": "audio/7583382cddb382ed4a59.mp3"}]}, {"id": "A1-11", "level": "A1", "title": "Marcar um encontro", "goal": "Usar am, um e im em expressões de tempo.", "rule": "Use um com horas, am com dias da semana e partes do dia, e im com meses e estações. Exceção frequente: in der Nacht. Se uma expressão abre uma afirmação, o verbo conjugado continua na segunda posição.", "task": "Marque um encontro dizendo um dia e um horário.", "story": [{"de": "Der Kurs beginnt um neun Uhr.", "pt": "O curso começa às nove horas.", "audio": "audio/564ada3c4bfac0d4f1b8.mp3"}, {"de": "Am Montag habe ich Zeit.", "pt": "Na segunda-feira eu tenho tempo.", "audio": "audio/a9007c4279d0064d9b12.mp3"}, {"de": "Im November ist es oft kalt.", "pt": "Em novembro costuma fazer frio.", "audio": "audio/8e9236191ba276583a91.mp3"}, {"de": "Treffen wir uns am Nachmittag?", "pt": "Vamos nos encontrar à tarde?", "audio": "audio/f79b154350d5bdf4b6fd.mp3"}]}, {"id": "A1-12", "level": "A1", "title": "Pedir e orientar", "goal": "Formar instruções simples no imperativo.", "rule": "No imperativo com du, normalmente retiramos du e -st: Komm! Alguns verbos mudam a vogal: Lies! Com ihr, use a forma de ihr sem o pronome: Macht! No formal, mantenha Sie depois do verbo: Sprechen Sie!", "task": "Escreva uma instrução informal e um pedido formal com bitte.", "story": [{"de": "Komm bitte herein!", "pt": "Entre, por favor!", "audio": "audio/5dcd33b6fbed9c838557.mp3"}, {"de": "Lies bitte den Text!", "pt": "Leia o texto, por favor!", "audio": "audio/8d0a0212e6a84bb51784.mp3"}, {"de": "Sprechen Sie bitte langsam!", "pt": "Fale devagar, por favor! (formal)", "audio": "audio/02c67180a75533f0a570.mp3"}, {"de": "Macht bitte die Übung!", "pt": "Façam o exercício, por favor!", "audio": "audio/cb4a28d46dbc2695922e.mp3"}]}, {"id": "A2-01", "level": "A2", "title": "O que fizemos ontem", "goal": "Construir Perfekt com haben.", "rule": "O Perfekt combina haben ou sein no presente com Partizip II no final. Muitos verbos regulares usam ge- + radical + -t: gelernt, gemacht. Verbos em -ieren não recebem ge-, como studiert.", "task": "Conte duas atividades de ontem no Perfekt.", "story": [{"de": "Ich habe gestern Deutsch gelernt.", "pt": "Eu estudei alemão ontem.", "audio": "audio/43496a69484ca7d2f25b.mp3"}, {"de": "Sofia hat eine Suppe gekocht.", "pt": "Sofia preparou uma sopa.", "audio": "audio/1f6120c354fa6221463a.mp3"}, {"de": "Hast du die Übung gemacht?", "pt": "Você fez o exercício?", "audio": "audio/4f2c8ae5843351d5f71c.mp3"}, {"de": "Ja, wir haben zusammen geübt.", "pt": "Sim, nós praticamos juntos.", "audio": "audio/ac5b72c06fa53a98a16e.mp3"}]}, {"id": "A2-02", "level": "A2", "title": "Uma viagem curta", "goal": "Construir Perfekt com sein.", "rule": "Muitos verbos de deslocamento e mudança de estado usam sein no Perfekt: ist gefahren, ist angekommen, ist eingeschlafen. O particípio pode ser irregular e deve ser aprendido com o verbo.", "task": "Conte para onde foi e quando chegou.", "story": [{"de": "Wir sind nach Berlin gefahren.", "pt": "Nós fomos de transporte para Berlim.", "audio": "audio/07890c4000b71ab3d92f.mp3"}, {"de": "Wann seid ihr angekommen?", "pt": "Quando vocês chegaram?", "audio": "audio/afe51483217e0dbb4eb5.mp3"}, {"de": "Wir sind am Abend angekommen.", "pt": "Nós chegamos à noite.", "audio": "audio/9845f87ed5f4bd3a9be1.mp3"}, {"de": "Sofia ist früh eingeschlafen.", "pt": "Sofia adormeceu cedo.", "audio": "audio/c01766f214f7b96f5eb9.mp3"}]}, {"id": "A2-03", "level": "A2", "title": "Como era antes", "goal": "Usar war e hatte.", "rule": "War e hatte são formas do Präteritum de sein e haben. Use ich/er war, du warst, wir/sie waren; ich/er hatte, du hattest, wir/sie hatten. São frequentes também na fala.", "task": "Descreva onde estava e o que tinha no ano passado.", "story": [{"de": "Letztes Jahr war ich in Berlin.", "pt": "No ano passado eu estava em Berlim.", "audio": "audio/9f2199ff24a7581fecc0.mp3"}, {"de": "Hattest du viel Zeit?", "pt": "Você tinha muito tempo?", "audio": "audio/59307582894fb3e1286e.mp3"}, {"de": "Nein, ich hatte viel Arbeit.", "pt": "Não, eu tinha muito trabalho.", "audio": "audio/8b7daae16234c2d3d2ac.mp3"}, {"de": "Wir waren oft müde.", "pt": "Nós frequentemente estávamos cansados.", "audio": "audio/cf74a28beb7103968b4a.mp3"}]}, {"id": "A2-04", "level": "A2", "title": "Ajudar no curso", "goal": "Reconhecer o dativo.", "rule": "No dativo: der/das viram dem, die singular vira der e o plural usa den, geralmente com -n no substantivo. Helfen e danken pedem dativo; mit também pede dativo.", "task": "Escreva quem você ajuda e como vai para a aula.", "story": [{"de": "Ich helfe dem Mann.", "pt": "Eu ajudo o homem.", "audio": "audio/3406f3139cc2298106c6.mp3"}, {"de": "Sofia spricht mit der Lehrerin.", "pt": "Sofia conversa com a professora.", "audio": "audio/c055953cfcb68aabc2dd.mp3"}, {"de": "Wir fahren mit dem Bus.", "pt": "Nós vamos de ônibus.", "audio": "audio/318696fe3bef1650df6d.mp3"}, {"de": "Ich danke den Freunden.", "pt": "Eu agradeço aos amigos.", "audio": "audio/eeaeb032719344a9bbd8.mp3"}]}, {"id": "A2-05", "level": "A2", "title": "Organizar o apartamento", "goal": "Distinguir localização e destino.", "rule": "Preposições como in e auf podem usar dativo para localização (wo?) e acusativo para destino (wohin?). A distinção é localização ou direção, não simplesmente haver movimento.", "task": "Diga onde está um objeto e para onde você o coloca.", "story": [{"de": "Das Buch liegt auf dem Tisch.", "pt": "O livro está sobre a mesa.", "audio": "audio/60f4559b2750c7747fba.mp3"}, {"de": "Ich lege das Buch auf den Tisch.", "pt": "Eu coloco o livro sobre a mesa.", "audio": "audio/232c9a0b2e7ff4f20192.mp3"}, {"de": "Sofia ist in der Küche.", "pt": "Sofia está na cozinha.", "audio": "audio/17a863e3465f72c677cf.mp3"}, {"de": "Sie geht in die Küche.", "pt": "Ela vai para a cozinha.", "audio": "audio/e6ed651be5fac8a91393.mp3"}]}, {"id": "A2-06", "level": "A2", "title": "Dar uma razão", "goal": "Usar weil e dass com verbo no final.", "rule": "Weil introduz uma razão e dass introduz uma oração de conteúdo. Nessas subordinadas, o verbo conjugado vai ao final: weil ich müde bin; dass der Kurs interessant ist.", "task": "Dê uma razão para estudar alemão usando weil.", "story": [{"de": "Ich lerne Deutsch, weil ich in Deutschland arbeiten möchte.", "pt": "Eu estudo alemão porque quero trabalhar na Alemanha.", "audio": "audio/95f2b2007bfaac39a357.mp3"}, {"de": "Sofia sagt, dass der Kurs interessant ist.", "pt": "Sofia diz que o curso é interessante.", "audio": "audio/9d0e82be87aee791c6e2.mp3"}, {"de": "Ich bleibe zu Hause, weil ich müde bin.", "pt": "Eu fico em casa porque estou cansado.", "audio": "audio/b2b4b12a04f1a02df74d.mp3"}, {"de": "Wir hoffen, dass wir bald besser sprechen.", "pt": "Nós esperamos falar melhor em breve.", "audio": "audio/28de5e39e0b65e6df748.mp3"}]}, {"id": "A2-07", "level": "A2", "title": "Cuidar da rotina", "goal": "Usar pronomes reflexivos no acusativo.", "rule": "Alguns verbos usam pronome reflexivo: ich freue mich, du freust dich, sie freut sich, wir freuen uns. Aprenda a combinação com a preposição: sich für etwas interessieren; sich auf etwas freuen.", "task": "Diga por que assunto se interessa e algo que espera com alegria.", "story": [{"de": "Ich freue mich auf den Kurs.", "pt": "Eu estou animado para o curso.", "audio": "audio/2a11fe16a8d144d0d6e7.mp3"}, {"de": "Freust du dich auch?", "pt": "Você também está animado?", "audio": "audio/39de826c2cb926ed39b5.mp3"}, {"de": "Sofia interessiert sich für Musik.", "pt": "Sofia se interessa por música.", "audio": "audio/9e95564685060d45b9e8.mp3"}, {"de": "Wir treffen uns um acht Uhr.", "pt": "Nós nos encontramos às oito horas.", "audio": "audio/12410e2e19774bb1b51b.mp3"}]}, {"id": "A2-08", "level": "A2", "title": "Comparar opções", "goal": "Usar comparativo e superlativo.", "rule": "O comparativo geralmente recebe -er e usa als na comparação. O superlativo predicativo usa am ...-sten. Há mudanças vocálicas e formas irregulares: kurz/kürzer/am kürzesten; gern/lieber/am liebsten.", "task": "Compare dois meios de transporte usando als.", "story": [{"de": "Der Zug ist schneller als der Bus.", "pt": "O trem é mais rápido que o ônibus.", "audio": "audio/6d2fcacc02c58a0e6f92.mp3"}, {"de": "Der Bus ist billiger.", "pt": "O ônibus é mais barato.", "audio": "audio/a8a004f53fb7b8b6d12f.mp3"}, {"de": "Welcher Weg ist am kürzesten?", "pt": "Qual caminho é o mais curto?", "audio": "audio/cc7c78dd6b2de9e49702.mp3"}, {"de": "Ich fahre lieber mit dem Zug.", "pt": "Eu prefiro ir de trem.", "audio": "audio/7ca58164bbb47e842e28.mp3"}]}, {"id": "A2-09", "level": "A2", "title": "Pedir com delicadeza", "goal": "Fazer pedidos com könnte e würde.", "rule": "Konjunktiv II torna pedidos mais corteses. Use könnte com infinitivo e würde + infinitivo: Könnten Sie helfen? Ich würde bestellen. O infinitivo fica no final.", "task": "Escreva um pedido formal e um pedido informal cortês.", "story": [{"de": "Könnten Sie mir bitte helfen?", "pt": "O senhor ou a senhora poderia me ajudar?", "audio": "audio/bad07e3377367abc298a.mp3"}, {"de": "Ich würde gern einen Tee bestellen.", "pt": "Eu gostaria de pedir um chá.", "audio": "audio/a7cde65c0651f34417aa.mp3"}, {"de": "Könntest du das bitte wiederholen?", "pt": "Você poderia repetir isso, por favor?", "audio": "audio/05b484750d83e290dc71.mp3"}, {"de": "Natürlich, ich spreche langsamer.", "pt": "Claro, eu falo mais devagar.", "audio": "audio/7a3fe4ac3f564cc4f689.mp3"}]}, {"id": "A2-10", "level": "A2", "title": "Escolher roupas", "goal": "Usar terminações de adjetivos.", "rule": "Antes do substantivo, o adjetivo recebe uma terminação que depende de caso, gênero e artigo. Nestes exemplos: der rote Pullover (nominativo); einen warmen Mantel (acusativo masculino); eine blaue Jacke (acusativo feminino).", "task": "Descreva duas peças de roupa usando adjetivos antes dos substantivos.", "story": [{"de": "Der rote Pullover ist schön.", "pt": "O suéter vermelho é bonito.", "audio": "audio/76158c46b2132f8573ee.mp3"}, {"de": "Ich suche einen warmen Mantel.", "pt": "Eu procuro um casaco quente.", "audio": "audio/19185fb6623f099b280b.mp3"}, {"de": "Sofia trägt eine blaue Jacke.", "pt": "Sofia está usando uma jaqueta azul.", "audio": "audio/0c7d4608db0c5fa7f873.mp3"}, {"de": "Das neue Hemd ist günstig.", "pt": "A camisa nova tem um bom preço.", "audio": "audio/ef253e6573d2c91b724b.mp3"}]}, {"id": "A2-11", "level": "A2", "title": "Explicar de quem falamos", "goal": "Formar orações relativas simples.", "rule": "O pronome relativo retoma gênero e número do substantivo. Seu caso depende da função na relativa. O verbo conjugado fica no final: die Deutsch spricht. No nominativo: der, die, das, die (plural).", "task": "Descreva uma pessoa usando uma oração relativa simples.", "story": [{"de": "Das ist der Mann, der im Kurs lernt.", "pt": "Este é o homem que estuda no curso.", "audio": "audio/9cac4c82e21e69cbd489.mp3"}, {"de": "Hier ist die Frau, die Deutsch spricht.", "pt": "Aqui está a mulher que fala alemão.", "audio": "audio/2a2443036a1bd3086db4.mp3"}, {"de": "Ich lese das Buch, das du empfohlen hast.", "pt": "Eu leio o livro que você recomendou.", "audio": "audio/2faee87ccd64d8d885d1.mp3"}, {"de": "Das sind die Leute, die hier wohnen.", "pt": "Estas são as pessoas que moram aqui.", "audio": "audio/e43e0d818b8a15cb5caa.mp3"}]}, {"id": "A2-12", "level": "A2", "title": "Lembranças e situações repetidas", "goal": "Distinguir als e wenn.", "rule": "Als introduz uma situação ou período único no passado. Wenn pode indicar repetição, condição ou situação presente/futura. O verbo vai ao final da subordinada; se ela abre a frase, a principal começa com o verbo conjugado.", "task": "Conte uma lembrança com als e um hábito com wenn.", "story": [{"de": "Als ich ein Kind war, wohnte ich in Brasilien.", "pt": "Quando eu era criança, morava no Brasil.", "audio": "audio/a67d28c3dfbae1cac791.mp3"}, {"de": "Wenn ich Zeit habe, lerne ich Deutsch.", "pt": "Quando tenho tempo, estudo alemão.", "audio": "audio/a17443a8d8bae8cdd66a.mp3"}, {"de": "Als wir in Berlin ankamen, war es spät.", "pt": "Quando chegamos a Berlim, era tarde.", "audio": "audio/e33ac4e7a3212eb7d655.mp3"}, {"de": "Wenn es regnet, bleiben wir zu Hause.", "pt": "Quando chove, ficamos em casa.", "audio": "audio/558d3b2e4452f715d676.mp3"}]}], "dialogues": [{"id": 1, "title": "Apresentar-se", "category": "Primeiras conversas"}, {"id": 2, "title": "Cumprimentar", "category": "Primeiras conversas"}, {"id": 3, "title": "Soletrar o nome", "category": "Primeiras conversas"}, {"id": 4, "title": "De onde você é", "category": "Primeiras conversas"}, {"id": 5, "title": "Falar da família", "category": "Primeiras conversas"}, {"id": 6, "title": "Idade", "category": "Primeiras conversas"}, {"id": 7, "title": "Idiomas", "category": "Primeiras conversas"}, {"id": 8, "title": "Pedir repetição", "category": "Primeiras conversas"}, {"id": 9, "title": "Trocar contato", "category": "Primeiras conversas"}, {"id": 10, "title": "Despedir-se", "category": "Primeiras conversas"}, {"id": 11, "title": "Pedir um café", "category": "Comer e beber"}, {"id": 12, "title": "Na padaria", "category": "Comer e beber"}, {"id": 13, "title": "Pedir o cardápio", "category": "Comer e beber"}, {"id": 14, "title": "Pedir almoço", "category": "Comer e beber"}, {"id": 15, "title": "Sem carne", "category": "Comer e beber"}, {"id": 16, "title": "Alergia alimentar", "category": "Comer e beber"}, {"id": 17, "title": "Pedir água", "category": "Comer e beber"}, {"id": 18, "title": "Pedir a conta", "category": "Comer e beber"}, {"id": 19, "title": "Levar para viagem", "category": "Comer e beber"}, {"id": 20, "title": "Reserva no restaurante", "category": "Comer e beber"}, {"id": 21, "title": "Encontrar leite", "category": "Compras"}, {"id": 22, "title": "Preço de frutas", "c